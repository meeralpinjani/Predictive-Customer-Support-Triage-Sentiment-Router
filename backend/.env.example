# NLP engine: hf (transformer models, falls back to rules automatically) | rules
NLP_MODE=hf
# PostgreSQL (the only database). Local: your own server. Hosted: e.g. Neon (postgres://... or postgresql://...)
DATABASE_URL=postgresql://triage:CHANGE_ME@localhost:5432/triage
CORS_ORIGINS=http://localhost:5173

# Accounts
# Signs session cookies. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# "Sign in with Google": paste your OAuth Web Client ID (see README). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
# This email becomes an admin when it signs up or signs in with Google.
ADMIN_EMAIL=
# Predefined demo accounts (passwords generated into demo_accounts.local.json). Set false for real use.
SEED_DEMO_ACCOUNTS=true
# Hosted: fixed demo passwords instead of the local file (the server's disk is wiped on restart)
# DEMO_PASSWORD=
# DEMO_ADMIN_PASSWORD=
# Set true when served over HTTPS
COOKIE_SECURE=false


# Set to 1 on demo day once the models are cached, so nothing tries the network
# HF_HUB_OFFLINE=1

# Optional overrides. Tuned defaults live in app/config.py; only set these to experiment.
# LEVEL3_SCORE=65
# FRUSTRATION_SENIOR=0.42
# KB_AUTO_THRESHOLD_HF=0.69

# Integrity review aid (admins only; see docs/integrity/). Off by default.
# Download the detector once:  python -m scripts.download_integrity_model
# AI_INTEGRITY_ENABLED=true
# AI_INTEGRITY_MODEL_PATH=models/ai-text-detector-modernbert
# Provisional thresholds (not validated on real data):
# AI_INTEGRITY_MIN_WORDS=40
# AI_INTEGRITY_REVIEW_THRESHOLD=0.80
# AI_INTEGRITY_DUPLICATE_THRESHOLD=0.90
# AI_INTEGRITY_DUPLICATE_THRESHOLD_TFIDF=0.80
# AI_INTEGRITY_CHUNK_SIZE=512
# AI_INTEGRITY_CHUNK_OVERLAP=64
# AI_INTEGRITY_TIMEOUT_SECONDS=5
# AI_INTEGRITY_MAX_FILE_SIZE_MB=10
# AI_INTEGRITY_MAX_DOCUMENT_PAGES=20

# Ticket summaries & handovers (see docs/summaries/). Rule-based summaries are on by default;
# turning them off never affects messages, routing or handovers (handovers fall back to raw messages).
# TICKET_SUMMARY_ENABLED=true
# Optional local AI refinement: measured too slow and inaccurate on CPU, so off.
# TICKET_SUMMARY_LLM_ENABLED=false
# TICKET_SUMMARY_LLM_MODEL_PATH=models/qwen2.5-0.5b-instruct
# TICKET_SUMMARY_LLM_TIMEOUT_SECONDS=10
# TICKET_SUMMARY_MAX_INPUT_MESSAGES=50
# TICKET_SUMMARY_RECONCILE_INTERVAL_MINUTES=60
